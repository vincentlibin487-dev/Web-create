{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and usage stats scoped per Google-authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the signed-in user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name from Google profile."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Gmail address from Google OAuth."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL."
        },
        "appsCount": {
          "type": "integer",
          "description": "Count of generated apps by this user."
        },
        "loginCount": {
          "type": "integer",
          "description": "Total number of authenticated visits/sessions by this user."
        },
        "lastVisitDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Most recent UTC YYYY-MM-DD visit date."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last login timestamp."
        }
      },
      "required": ["uid", "name", "email", "appsCount", "createdAt", "lastLoginAt"]
    },
    "WebProject": {
      "title": "WebProject",
      "description": "A multi-file website or web application generated by Gemini AI and owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique project identifier."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning Google user."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Custom Project / Website Name."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Short summary of the project."
        },
        "prompt": {
          "type": "string",
          "maxLength": 5000,
          "description": "Original generation prompt."
        },
        "files": {
          "type": "array",
          "description": "Separated source files (index.html, style.css, script.js, package.json, README.md)."
        },
        "fullCode": {
          "type": "string",
          "maxLength": 350000,
          "description": "Self-contained HTML preview bundle."
        },
        "starred": {
          "type": "boolean",
          "description": "Whether the project is starred."
        },
        "publishedSlug": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Permanent live link slug linked to this project."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest publish or republish."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "title", "description", "prompt", "files", "fullCode", "starred", "createdAt", "updatedAt"]
    },
    "PublishedSite": {
      "title": "PublishedSite",
      "description": "Publicly accessible live HTML snapshot linked to a project's permanent shareable URL without any PII.",
      "type": "object",
      "properties": {
        "siteId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Permanent shareable URL slug matching document ID."
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Source WebProject document ID."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the project owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Published website title."
        },
        "fullCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000,
          "description": "Live standalone HTML bundle served on the permanent link."
        },
        "version": {
          "type": "integer",
          "description": "Monotonically increasing publish/republish revision number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Initial publish server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest republish/update server timestamp."
        }
      },
      "required": ["siteId", "projectId", "ownerId", "title", "fullCode", "version", "createdAt", "updatedAt"]
    },
    "DailyStat": {
      "title": "DailyStat",
      "description": "Aggregated daily visit and unique user entrance counts for admin analytics (no PII).",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date in YYYY-MM-DD format."
        },
        "visitsCount": {
          "type": "integer",
          "description": "Total user sessions/visits recorded on this day."
        },
        "uniqueUsersCount": {
          "type": "integer",
          "description": "Unique authenticated users who entered on this day."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest server timestamp for this date record."
        }
      },
      "required": ["date", "visitsCount", "uniqueUsersCount", "updatedAt"]
    },
    "DailyVisitor": {
      "title": "DailyVisitor",
      "description": "Per-user daily presence record preventing duplicate unique user counts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID."
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date in YYYY-MM-DD format."
        },
        "visitCount": {
          "type": "integer",
          "description": "Number of visits by this user on this day."
        },
        "visitedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Most recent visit timestamp on this day."
        }
      },
      "required": ["uid", "date", "visitCount", "visitedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private Google-authenticated user profile and activity stats (PII isolated to owner or verified admin)."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/WebProject" },
      "description": "User-owned multi-file AI generated web projects."
    },
    "/published_sites/{siteId}": {
      "schema": { "$ref": "#/entities/PublishedSite" },
      "description": "Permanent shareable live website snapshots updatable in-place by the project owner."
    },
    "/daily_stats/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyStat" },
      "description": "Daily visitor and session metrics displayed in Admin Dashboard."
    },
    "/daily_stats/{dateKey}/visitors/{visitorId}": {
      "schema": { "$ref": "#/entities/DailyVisitor" },
      "description": "Daily unique visitor markers scoped under each dateKey."
    }
  }
}
