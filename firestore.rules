rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amalj7767@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'appsCount', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'appsCount', 'loginCount', 'lastVisitDate', 'createdAt', 'lastLoginAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.appsCount is int && data.appsCount >= 0 && data.appsCount <= 10000
        && (!('loginCount' in data) || (data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 1000000))
        && (!('lastVisitDate' in data) || isValidDateKey(data.lastVisitDate))
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidFileEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['path', 'content'])
        && entry.keys().hasOnly(['path', 'content'])
        && entry.path is string && entry.path.size() >= 1 && entry.path.size() <= 120
        && entry.content is string && entry.content.size() <= 150000;
    }

    function isValidWebProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'description', 'prompt', 'files', 'fullCode', 'starred', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'description', 'prompt', 'files', 'fullCode', 'starred', 'publishedSlug', 'publishedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == projectId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 2000
        && data.prompt is string && data.prompt.size() <= 5000
        && data.files is list && data.files.size() >= 1 && data.files.size() <= 15
        && isValidFileEntry(data.files[0])
        && data.fullCode is string && data.fullCode.size() <= 350000
        && data.starred is bool
        && (!('publishedSlug' in data) || isValidId(data.publishedSlug))
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublishedSite(data, siteId) {
      return data.keys().hasAll(['siteId', 'projectId', 'ownerId', 'title', 'fullCode', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['siteId', 'projectId', 'ownerId', 'title', 'fullCode', 'version', 'createdAt', 'updatedAt'])
        && isValidId(data.siteId)
        && data.siteId == siteId
        && isValidId(data.projectId)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.fullCode is string && data.fullCode.size() >= 1 && data.fullCode.size() <= 350000
        && data.version is int && data.version >= 1 && data.version <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyStat(data, dateKey) {
      return data.keys().hasAll(['date', 'visitsCount', 'uniqueUsersCount', 'updatedAt'])
        && data.keys().hasOnly(['date', 'visitsCount', 'uniqueUsersCount', 'updatedAt'])
        && isValidDateKey(data.date)
        && data.date == dateKey
        && data.visitsCount is int && data.visitsCount >= 0 && data.visitsCount <= 10000000
        && data.uniqueUsersCount is int && data.uniqueUsersCount >= 0 && data.uniqueUsersCount <= 10000000
        && data.updatedAt is timestamp;
    }

    function isValidDailyVisitor(data, dateKey, visitorId) {
      return data.keys().hasAll(['uid', 'date', 'visitCount', 'visitedAt'])
        && data.keys().hasOnly(['uid', 'date', 'visitCount', 'visitedAt'])
        && isValidId(data.uid)
        && data.uid == visitorId
        && data.uid == request.auth.uid
        && isValidDateKey(data.date)
        && data.date == dateKey
        && data.visitCount is int && data.visitCount >= 1 && data.visitCount <= 10000
        && data.visitedAt is timestamp;
    }

    // 4. Connection Health Check Document (Read-Only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 5. Admins Directory (Read-Only for Owner, Write-Locked)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, write: if false;
    }

    // 6. User Profiles Collection (PII Strictly Isolated to Owner or Verified Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'appsCount', 'loginCount', 'lastVisitDate', 'lastLoginAt']);

      allow delete: if false;

      // 7. User-Owned Multi-File Projects Subcollection (Master Gate Ownership)
      match /projects/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWebProject(incoming(), userId, projectId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidWebProject(incoming(), userId, projectId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'prompt', 'files', 'fullCode', 'starred', 'publishedSlug', 'publishedAt', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
      }
    }

    // 8. Permanent Published Live Websites (Public single-doc get, Owner in-place Republish/Update)
    match /published_sites/{siteId} {
      allow get: if isValidId(siteId);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isValidId(siteId)
        && isSignedIn()
        && isValidPublishedSite(incoming(), siteId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(incoming().projectId))
        && incoming().version == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(siteId)
        && isSignedIn()
        && isValidPublishedSite(incoming(), siteId)
        && (
          isAdmin() || (
            existing().ownerId == request.auth.uid
            && incoming().siteId == existing().siteId
            && incoming().projectId == existing().projectId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().version == existing().version + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'fullCode', 'version', 'updatedAt'])
          )
        );

      allow delete: if isValidId(siteId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 9. Daily Visitor & Session Analytics (Zero PII, Atomic Visitor Subcollection)
    match /daily_stats/{dateKey} {
      allow get: if isValidDateKey(dateKey) && isSignedIn();
      allow list: if isAdmin();

      allow create: if isValidDateKey(dateKey)
        && isSignedIn()
        && isValidDailyStat(incoming(), dateKey)
        && incoming().visitsCount == 1
        && incoming().uniqueUsersCount == 1
        && existsAfter(/databases/$(database)/documents/daily_stats/$(dateKey)/visitors/$(request.auth.uid))
        && incoming().updatedAt == request.time;

      allow update: if isValidDateKey(dateKey)
        && isSignedIn()
        && isValidDailyStat(incoming(), dateKey)
        && (
          isAdmin() || (
            incoming().date == existing().date
            && incoming().updatedAt == request.time
            && incoming().visitsCount == existing().visitsCount + 1
            && (incoming().uniqueUsersCount == existing().uniqueUsersCount || incoming().uniqueUsersCount == existing().uniqueUsersCount + 1)
            && existsAfter(/databases/$(database)/documents/daily_stats/$(dateKey)/visitors/$(request.auth.uid))
            && incoming().diff(existing()).affectedKeys().hasOnly(['visitsCount', 'uniqueUsersCount', 'updatedAt'])
          )
        );

      allow delete: if false;

      match /visitors/{visitorId} {
        allow get: if isValidDateKey(dateKey) && isValidId(visitorId) && (isOwner(visitorId) || isAdmin());
        allow list: if isValidDateKey(dateKey) && isAdmin();

        allow create: if isValidDateKey(dateKey)
          && isValidId(visitorId)
          && isOwner(visitorId)
          && isValidDailyVisitor(incoming(), dateKey, visitorId)
          && existsAfter(/databases/$(database)/documents/daily_stats/$(dateKey))
          && incoming().visitCount == 1
          && incoming().visitedAt == request.time;

        allow update: if isValidDateKey(dateKey)
          && isValidId(visitorId)
          && isOwner(visitorId)
          && isValidDailyVisitor(incoming(), dateKey, visitorId)
          && exists(/databases/$(database)/documents/daily_stats/$(dateKey))
          && incoming().uid == existing().uid
          && incoming().date == existing().date
          && incoming().visitCount == existing().visitCount + 1
          && incoming().visitedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['visitCount', 'visitedAt']);

        allow delete: if false;
      }
    }
  }
}
